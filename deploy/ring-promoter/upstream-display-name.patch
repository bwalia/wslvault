+          cpu_request: 100m
+          memory_limit: 512Mi
+        timeout: 20m
+        retries: 0
+        ttl_after_finished: 1h
+      rings:
+        int:
+          target_env: region-a
+          display_name: "region-a \xB7 Manchester"
+          health_url: https://vault-ui.workstation.co.uk/api/version
+          health_version_field: version
+          auto_promote: true
+        test:
+          target_env: region-b
+          display_name: "region-b \xB7 London"
+          health_url: https://vault-ha.workstation.co.uk/api/version
+          health_version_field: version
+          auto_promote: false
