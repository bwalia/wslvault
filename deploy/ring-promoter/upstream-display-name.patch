 internal/config/config.go                     |   9 +-
 internal/config/config_test.go                |  41 ++++
 internal/promoter/promoter.go                 |  15 +-
 .../components/dashboard/action-dialogs.tsx   |  10 +-
 web/src/components/dashboard/pipeline.tsx     |  61 ++++--
 web/src/lib/types.ts                          |  26 +++
 7 files changed, 256 insertions(+), 104 deletions(-)

diff --git a/deploy/k8s/configmap.yaml b/deploy/k8s/configmap.yaml
index f641b2f..13e6e12 100644
--- a/deploy/k8s/configmap.yaml
+++ b/deploy/k8s/configmap.yaml
@@ -7,6 +7,11 @@
 # ConfigMap. A ConfigMap change does not restart the pod on its own, so the
 # deploy workflow issues a rollout restart after applying it; by hand it is
 # `kubectl rollout restart deploy/ring-promoter -n workstation-ring-promoter`.
+#
+# wslvault app definition is authored in bwalia/wslvault
+# deploy/ring-promoter/wslvault.yaml — keep them in sync when editing.
+# Per-ring display_name (e.g. "region-a · Manchester") is shown as the primary
+# promotion-pipeline card title once the server/UI supports rings.*.display_name.
 apiVersion: v1
 kind: ConfigMap
 metadata:
@@ -14,88 +19,123 @@ metadata:
   namespace: workstation-ring-promoter
 data:
   config.yaml: |
-    listen_addr: ":8080"
-    deployer: log         # global default; jobshout overrides to k8sjob below
-    health: http          # real HTTP health checks against each ring's health_url
+    listen_addr: :8080
+    deployer: log
+    health: http
     database:
-      driver: postgres    # DSN comes from RP_DB_DSN (Secret)
+      driver: postgres
     retry:
       count: 3
       delay: 5s
     operation_timeout: 60m
     apps:
-      # jobshout — deployed via the K8SJOB deployer: each seed/promote/rollback
-      # runs as a short-lived Kubernetes Job in ring-exec (SA ring-deploy-job)
-      # that helm-installs the jobshout chart into the ring's namespace. The
-      # chart lives in the PUBLIC bwalia/jobshout repo, so the Job git-clones it
-      # at the promoted SHA. RP injects RP_TARGET_ENV (int|test|acc|prod) and
-      # RP_VERSION (the image tag). Requires the ring-exec RBAC in rbac.yaml and
-      # the images pushed by jobshout's deploy-k3s.yml workflow.
-      - name: jobshout
-        display_name: "JobShout"
-        location: { lat: 51.5074, lng: -0.1278, city: London, region: GB }
-        deployer: k8sjob
-        k8sjob:
-          namespace: ring-exec
-          image: docker.io/dtzar/helm-kubectl:3.15.4
-          service_account: ring-deploy-job
-          # SpectonCR registry creds (REGISTRY_USERNAME/REGISTRY_PASSWORD),
-          # injected as env for the helm --set below. Create the secret once:
-          #   kubectl -n ring-exec create secret generic jobshout-registry-creds \
-          #     --from-literal=REGISTRY_USERNAME=<user> \
-          #     --from-literal=REGISTRY_PASSWORD=<pass>
-          env_from_secrets: [jobshout-registry-creds]
-          # CNI overlay egress to github.com started failing ~2h after the last
-          # good helm (TLS timeout / connection reset). The node itself can still
-          # clone; hostNetwork uses that path.
-          host_network: true
-          command: ["/bin/sh", "-c"]
-          args:
-            - |
-              set -eu
-              ns="${RP_TARGET_ENV}"
-              echo "deploy jobshout ${RP_VERSION} -> ns ${ns}"
-              rm -rf /src
-              n=0
-              until git clone --depth 1 https://github.com/bwalia/jobshout /src; do
-                n=$((n+1))
-                if [ "$n" -ge 5 ]; then exit 1; fi
-                echo "git clone failed (attempt $n), retrying..."
-                sleep $((n*5))
-              done
-              # No --create-namespace: int/test/acc/prod are shared platform
-              # namespaces that pre-exist (RBAC here is namespaced to them). The
-              # ring-deploy-job SA has no cluster-scoped namespace rights.
-              #
-              # k3s1 has no External Secrets Operator, so use the chart's
-              # plaintext fallback (externalSecret.enabled=false) and pass the
-              # registry creds injected from jobshout-registry-creds so the
-              # pull secret is valid.
-              #
-              # --timeout 12m, not 5m: every seed pushes three freshly-built
-              # images (server/web/python-sidecar) that must be pulled COLD onto
-              # whichever node the pods land on — the pod's node rarely has them
-              # cached. That cold pull plus startup routinely runs past 5m, so
-              # helm's --wait gave up and marked the release failed while the
-              # pods went on to converge seconds later (int stayed up the whole
-              # time because maxUnavailable:0 keeps the old pods serving). 12m
-              # covers the cold-pull worst case and still finishes inside this
-              # job's 15m timeout below, so a genuinely stuck deploy still fails.
-              helm upgrade --install jobshout /src/deploy/helm/jobshout \
-                --namespace "${ns}" \
-                -f "/src/deploy/helm/jobshout/values-${ns}.yaml" \
-                --set image.tag="${RP_VERSION}" \
-                --set externalSecret.enabled=false \
-                --set-string secrets.registryUsername="${REGISTRY_USERNAME}" \
-                --set-string secrets.registryPassword="${REGISTRY_PASSWORD}" \
-                --wait --timeout 12m
-              echo "jobshout ${RP_VERSION} live in ${ns}"
-          resources: { cpu_request: 100m, memory_limit: 512Mi }
-          timeout: 15m
-          retries: 0
-          ttl_after_finished: 1h
-        rings:
-          int:  { target_env: int,  health_url: "http://jobshout-api.int.svc.cluster.local:8080/health" }
-          test: { target_env: test, health_url: "http://jobshout-api.test.svc.cluster.local:8080/health" }
-          acc:  { target_env: acc,  health_url: "http://jobshout-api.acc.svc.cluster.local:8080/health" }
-          prod: { target_env: prod, health_url: "http://jobshout-api.prod.svc.cluster.local:8080/health" }
+    - name: jobshout
+      display_name: JobShout
+      location:
+        lat: 51.5074
+        lng: -0.1278
+        city: London
+        region: GB
+      deployer: k8sjob
+      k8sjob:
+        namespace: ring-exec
+        image: docker.io/dtzar/helm-kubectl:3.15.4
+        service_account: ring-deploy-job
+        env_from_secrets:
+        - jobshout-registry-creds
+        host_network: true
+        command:
+        - /bin/sh
+        - -c
+        args:
+        - "set -eu\nns=\"${RP_TARGET_ENV}\"\necho \"deploy jobshout ${RP_VERSION} -> ns ${ns}\"\nrm -rf /src\n\
+          n=0\nuntil git clone --depth 1 https://github.com/bwalia/jobshout /src; do\n  n=$((n+1))\n  if [\
+          \ \"$n\" -ge 5 ]; then exit 1; fi\n  echo \"git clone failed (attempt $n), retrying...\"\n  sleep\
+          \ $((n*5))\ndone\n# No --create-namespace: int/test/acc/prod are shared platform\n# namespaces that\
+          \ pre-exist (RBAC here is namespaced to them). The\n# ring-deploy-job SA has no cluster-scoped namespace\
+          \ rights.\n#\n# k3s1 has no External Secrets Operator, so use the chart's\n# plaintext fallback\
+          \ (externalSecret.enabled=false) and pass the\n# registry creds injected from jobshout-registry-creds\
+          \ so the\n# pull secret is valid.\n#\n# --timeout 12m, not 5m: every seed pushes three freshly-built\n\
+          # images (server/web/python-sidecar) that must be pulled COLD onto\n# whichever node the pods land\
+          \ on \u2014 the pod's node rarely has them\n# cached. That cold pull plus startup routinely runs\
+          \ past 5m, so\n# helm's --wait gave up and marked the release failed while the\n# pods went on to\
+          \ converge seconds later (int stayed up the whole\n# time because maxUnavailable:0 keeps the old\
+          \ pods serving). 12m\n# covers the cold-pull worst case and still finishes inside this\n# job's\
+          \ 15m timeout below, so a genuinely stuck deploy still fails.\nhelm upgrade --install jobshout /src/deploy/helm/jobshout\
+          \ \\\n  --namespace \"${ns}\" \\\n  -f \"/src/deploy/helm/jobshout/values-${ns}.yaml\" \\\n  --set\
+          \ image.tag=\"${RP_VERSION}\" \\\n  --set externalSecret.enabled=false \\\n  --set-string secrets.registryUsername=\"\
+          ${REGISTRY_USERNAME}\" \\\n  --set-string secrets.registryPassword=\"${REGISTRY_PASSWORD}\" \\\n\
+          \  --wait --timeout 12m\necho \"jobshout ${RP_VERSION} live in ${ns}\"\n"
+        resources:
+          cpu_request: 100m
+          memory_limit: 512Mi
+        timeout: 15m
+        retries: 0
+        ttl_after_finished: 1h
+      rings:
+        int:
+          target_env: int
+          health_url: http://jobshout-api.int.svc.cluster.local:8080/health
+        test:
+          target_env: test
+          health_url: http://jobshout-api.test.svc.cluster.local:8080/health
+        acc:
+          target_env: acc
+          health_url: http://jobshout-api.acc.svc.cluster.local:8080/health
+        prod:
+          target_env: prod
+          health_url: http://jobshout-api.prod.svc.cluster.local:8080/health
+    - name: wslvault
+      display_name: WSLVault (k3s1 HA)
+      location:
+        lat: 53.4808
+        lng: -2.2426
+        city: Manchester
+        region: GB
+      deployer: k8sjob
+      k8sjob:
+        namespace: ring-exec
+        image: docker.io/dtzar/helm-kubectl:3.15.4
+        service_account: ring-deploy-job
+        host_network: true
+        command:
+        - /bin/sh
+        - -c
+        args:
+        - "set -eu\nenv=\"${RP_TARGET_ENV}\"\nver=\"${RP_VERSION}\"\ncase \"${env}\" in\n  region-a)\n   \
+          \ ns=\"wslvault\"\n    values=\"deploy/gitops/regions/region-a.values.yaml\"\n    ;;\n  region-b)\n\
+          \    ns=\"wslvault-b\"\n    values=\"deploy/gitops/regions/region-b.values.yaml\"\n    ;;\n  *)\n\
+          \    echo \"unknown RP_TARGET_ENV=${env} (expected region-a|region-b)\"\n    exit 1\n    ;;\nesac\n\
+          echo \"deploy wslvault ${ver} -> ns ${ns} (${env}, ring ${RP_RING})\"\nrm -rf /src\nn=0\nuntil git\
+          \ clone --depth 1 --branch \"${ver}\" https://github.com/bwalia/wslvault /src; do\n  n=$((n+1))\n\
+          \  if [ \"$n\" -ge 5 ]; then exit 1; fi\n  echo \"git clone failed (attempt $n), retrying...\"\n\
+          \  sleep $((n*5))\ndone\ncd /src\n# Region values pin explicit per-service tags; --set overrides\
+          \ all of\n# them plus global.imageTag so lease-manager / sync-scheduler (which\n# fall back to global)\
+          \ cannot lag behind.\n# No --create-namespace: wslvault / wslvault-b already exist; the\n# ring-deploy-job\
+          \ SA has no cluster-scoped namespace rights.\nhelm upgrade --install wslvault ./deploy/helm/wslvault\
+          \ \\\n  --namespace \"${ns}\" \\\n  -f \"${values}\" \\\n  --set global.imageTag=\"${ver}\" \\\n\
+          \  --set ui.image.tag=\"${ver}\" \\\n  --set identityService.image.tag=\"${ver}\" \\\n  --set regionHealth.image.tag=\"\
+          ${ver}\" \\\n  --set secretEngine.image.tag=\"${ver}\" \\\n  --set policyEngine.image.tag=\"${ver}\"\
+          \ \\\n  --set transitEngine.image.tag=\"${ver}\" \\\n  --set auditService.image.tag=\"${ver}\" \\\
+          \n  --set pkiEngine.image.tag=\"${ver}\" \\\n  --set mcpServer.image.tag=\"${ver}\" \\\n  --set\
+          \ cryptoService.image.tag=\"${ver}\" \\\n  --set replicationAgent.image.tag=\"${ver}\" \\\n  --wait\
+          \ --timeout 15m\necho \"wslvault ${ver} live in ${ns}\"\n"
