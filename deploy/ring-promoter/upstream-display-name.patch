diff --git a/internal/config/config_test.go b/internal/config/config_test.go
index 48ef9b0..9d42f44 100644
--- a/internal/config/config_test.go
+++ b/internal/config/config_test.go
@@ -513,3 +513,44 @@ apps:
 		t.Fatal("longitude out of range must be rejected")
 	}
 }
+
+func TestRingDisplayNameAndTargetEnv(t *testing.T) {
+	t.Setenv("RP_API_TOKEN", "tok")
+	body := `
+apps:
+  - name: wslvault
+    deployer: k8sjob
+    k8sjob:
+      namespace: ring-exec
+      image: docker.io/dtzar/helm-kubectl:3.15.4
+      service_account: ring-deploy-job
+      command: ["/bin/sh", "-c"]
+      args: ["echo ok"]
+    rings:
+      int:
+        target_env: region-a
+        display_name: "region-a · Manchester"
+        health_url: "https://vault-ui.example/api/version"
+        health_version_field: version
+      test:
+        target_env: region-b
+        display_name: "region-b · London"
+        health_url: "https://vault-ha.example/api/version"
+        health_version_field: version
+`
+	cfg, err := Load(writeConfig(t, body))
+	if err != nil {
+		t.Fatalf("load: %v", err)
+	}
+	intRing := cfg.Apps[0].Rings["int"]
+	if intRing.DisplayName != "region-a · Manchester" {
+		t.Fatalf("int DisplayName = %q", intRing.DisplayName)
+	}
+	if intRing.TargetEnv != "region-a" {
+		t.Fatalf("int TargetEnv = %q", intRing.TargetEnv)
+	}
+	testRing := cfg.Apps[0].Rings["test"]
+	if testRing.DisplayName != "region-b · London" {
+		t.Fatalf("test DisplayName = %q", testRing.DisplayName)
+	}
+}
