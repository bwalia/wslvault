+/** Primary label for a ring card / promote target in the pipeline UI. */
+export function ringDisplayLabel(view: RingView | undefined): string {
+  if (!view) return "the next ring";
+  const custom = view.display_name?.trim();
+  if (custom) return custom;
+  return view.ring.label;
+}
+
+/** Secondary cue under a custom display_name (shared ring + optional target_env). */
+export function ringDisplaySubtitle(view: RingView): string | undefined {
+  if (!view.display_name?.trim()) {
+    return view.target_env?.trim() || undefined;
+  }
+  const bits = [view.ring.label];
+  if (view.target_env?.trim()) bits.push(view.target_env.trim());
+  return bits.join(" · ");
+}
