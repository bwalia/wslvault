# Thin runtime image: packages one prebuilt binary from the shared builder.
FROM wslvault-builder:latest AS b
FROM --platform=linux/amd64 alpine:3.20
ARG SVC
RUN apk add --no-cache ca-certificates
COPY --from=b /app/target/x86_64-unknown-linux-musl/release/${SVC} /usr/local/bin/app
USER 65534:65534
ENTRYPOINT ["app"]
